from os import PathLike
from typing import Any

__version__: str

class Session:
    def __init__(self) -> None: ...
    def load(self, path: str | PathLike[str], object: str | None = None) -> str: ...
    def fetch(self, code: str, object: str | None = None) -> str: ...
    def do(self, command: str) -> str: ...
    def run(self, command: str) -> dict[str, Any]: ...
    def count_atoms(self, selection: str = "all") -> int: ...
    def get_coords(self, selection: str = "all") -> list[list[float]]: ...
    def get_atoms(self, selection: str = "all") -> list[dict[str, Any]]: ...
    def get_names(self) -> list[str]: ...
    def get_measurements(self) -> list[dict[str, Any]]: ...
    def turn(self, axis: str, angle: float) -> None: ...
    def reset(self) -> None: ...
    def quit(self) -> bool: ...
    def png(self, path: str | PathLike[str], width: int = 1600, height: int = 1000) -> None: ...
    def save(self, path: str | PathLike[str]) -> None: ...
    def alter(self, changes: list[tuple[int, str, str]]) -> int: ...
    def export(self, path: str | PathLike[str], selection: str = "all") -> None: ...

def run_viewer(session: Session, title: str = "rsmol") -> None:
    """Opens a viewer window on `session` until it closes. Main thread only."""
