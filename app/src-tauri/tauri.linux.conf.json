{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "bun run wasm && bun run dev",
    "beforeBuildCommand": "bun run wasm && bun run build"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "rsmol",
